{
  "name": "dli-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:ai-compliance": "node scripts/verify-ai-compliance.mjs",
    "prebuild": "node scripts/verify-ai-compliance.mjs && node scripts/verify-migration-integrity.mjs && node scripts/verify-paid-learning-plans.mjs",
    "check:bundle-scanner": "node scripts/verify-browser-bundle.mjs --self-test",
    "check:browser-bundle": "node scripts/verify-browser-bundle.mjs",
    "postbuild": "node scripts/verify-browser-bundle.mjs",
    "check:release-env-tests": "node scripts/verify-release-env.mjs --self-test",
    "check:release-env": "node scripts/verify-release-env.mjs",
    "build:release": "npm run check:release-env && npm run build",
    "check:migration-integrity": "node scripts/verify-migration-integrity.mjs",
    "check:migration-integrity-tests": "node scripts/verify-migration-integrity.mjs --self-test",
    "check:backup-file-tests": "node scripts/verify-backup-files.mjs --self-test",
    "check:backup-files": "node scripts/verify-backup-files.mjs",
    "check:paid-learning-plans": "node scripts/verify-paid-learning-plans.mjs",
    "check:role-matrix": "node scripts/verify-role-matrix.mjs",
    "check:recovery-bundle-tests": "node scripts/verify-recovery-bundle.mjs --self-test",
    "check:recovery-bundle": "node scripts/verify-recovery-bundle.mjs",
    "check:file-picker-focus": "node scripts/verify-file-picker-focus.mjs",
    "check:q5-release-safety": "node scripts/verify-q5-release-safety.mjs",
    "check:recovery-receipt-tests": "node scripts/create-recovery-manifest.mjs --self-test",
    "prepare:recovery-receipt": "node scripts/create-recovery-manifest.mjs",
    "check:guest-login": "node scripts/verify-guest-login.mjs",
    "check:deployment-identity": "node --experimental-strip-types scripts/verify-deployment-identity.mjs",
    "check:academic-hierarchy": "node scripts/verify-academic-hierarchy.mjs",
    "check:official-branding": "node scripts/verify-official-branding.mjs",
    "check:q15-production-ui": "node scripts/verify-q15-production-ui.mjs",
    "check:q16-admin-routed-chat": "node scripts/verify-q16-admin-routed-chat.mjs",
    "check:q22-user-actions": "node scripts/verify-user-actions.mjs",
    "check:q22-user-lifecycle": "node scripts/verify-user-lifecycle.mjs",
    "check:q22-operational-tools": "node scripts/verify-operational-tools.mjs",
    "check:q22-feature-reconciliation": "node scripts/verify-q22-feature-reconciliation.mjs",
    "check:q23-manual-payments": "node scripts/verify-q23-manual-payments.mjs",
    "check:q24-tutor-payout": "node scripts/verify-q24-tutor-payout.mjs",
    "check:q25-operational-hardening": "node scripts/verify-q25-operational-hardening.mjs",
    "check:q27-academic-pro": "node scripts/verify-academic-pro-design.mjs",
    "check:q28-reference-dashboard": "node scripts/verify-reference-dashboard.mjs",
    "check:q29-editable-paid-plans": "node scripts/verify-q29-editable-paid-plans.mjs",
    "check:q30-finance-editor": "node scripts/verify-q30-finance-editor.mjs",
    "check:q31-sidebar-navigation": "node scripts/verify-q31-sidebar-navigation.mjs",
    "check:q32-chat-profiles": "node scripts/verify-q32-chat-profiles.mjs",
    "check:q33-unified-classes": "node scripts/verify-q33-unified-classes.mjs",
    "check:q34-curriculum-telegram": "node scripts/verify-q34-curriculum-telegram.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
