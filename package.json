{
  "name": "dli-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:ai-compliance": "node scripts/verify-ai-compliance.mjs",
    "prebuild": "node scripts/verify-ai-compliance.mjs && node scripts/verify-migration-integrity.mjs && node scripts/verify-paid-learning-plans.mjs",
    "check:bundle-scanner": "node scripts/verify-browser-bundle.mjs --self-test",
    "check:browser-bundle": "node scripts/verify-browser-bundle.mjs",
    "postbuild": "node scripts/verify-browser-bundle.mjs",
    "check:release-env-tests": "node scripts/verify-release-env.mjs --self-test",
    "check:release-env": "node scripts/verify-release-env.mjs",
    "build:release": "npm run check:release-env && npm run build",
    "check:migration-integrity": "node scripts/verify-migration-integrity.mjs",
    "check:migration-integrity-tests": "node scripts/verify-migration-integrity.mjs --self-test",
    "check:backup-file-tests": "node scripts/verify-backup-files.mjs --self-test",
    "check:backup-files": "node scripts/verify-backup-files.mjs",
    "check:paid-learning-plans": "node scripts/verify-paid-learning-plans.mjs",
    "check:role-matrix": "node scripts/verify-role-matrix.mjs",
    "check:recovery-bundle-tests": "node scripts/verify-recovery-bundle.mjs --self-test",
    "check:recovery-bundle": "node scripts/verify-recovery-bundle.mjs",
    "check:file-picker-focus": "node scripts/verify-file-picker-focus.mjs",
    "check:q5-release-safety": "node scripts/verify-q5-release-safety.mjs",
    "check:recovery-receipt-tests": "node scripts/create-recovery-manifest.mjs --self-test",
    "prepare:recovery-receipt": "node scripts/create-recovery-manifest.mjs",
    "check:enrolment-catalogue": "node scripts/verify-enrolment-catalogue.mjs",
    "check:workspace-consistency": "node scripts/verify-workspace-consistency.mjs",
    "check:operational-tools": "node scripts/verify-operational-tools.mjs",
    "check:class-offering-link": "node scripts/verify-class-offering-link.mjs",
    "check:auth-guest-recovery": "node --experimental-strip-types scripts/verify-auth-guest-recovery.mjs",
    "check:recovery-rate-limit": "node --experimental-strip-types scripts/verify-recovery-rate-limit.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
