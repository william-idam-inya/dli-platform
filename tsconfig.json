{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "verbatimModuleSyntax": true,
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"],
  "exclude": [
    "src/components/CallProvider.tsx",
    "src/components/DirectCallOverlay.tsx",
    "src/components/CallHistoryPanel.tsx",
    "src/components/CallMessageAlertsBanner.tsx",
    "src/lib/useDirectPeerCall.ts",
    "src/lib/callRingtone.ts"
  ]
}
